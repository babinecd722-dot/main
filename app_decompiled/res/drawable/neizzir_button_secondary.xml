<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="#3300b7a3"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#ff0a1513" />
            <corners android:radius="22.0dip" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#ff10241f" />
                    <corners android:radius="22.0dip" />
                    <stroke android:width="1.0dip" android:color="#ff00b7a3" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#ff07110f" />
                    <corners android:radius="22.0dip" />
                    <stroke android:width="1.0dip" android:color="#ff126e65" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>